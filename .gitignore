# Secrets and local environment overrides
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx

# Python environments, builds, caches, and test output
.venv/
venv/
ENV/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.tmp/
.uv-cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/
examples/reports/

# Legacy frontend generated output left by pre-split checkouts
frontend/node_modules/
frontend/dist/
frontend/test-results/
frontend/playwright-report/

# Local application state and uploaded research data: one save per folder
# under data/saves/<save>/ (graph, settings, uploads, task log).
data/saves/

# Local tooling and diagnostics
.spec-render/
*.log
# QE replay demo fixture is required by the demo and tests, so keep it despite *.log
!backend/domain_packages/qe_demo_fixtures/*.log
.DS_Store
Thumbs.db

# Local working notes: handoff snapshots stay on the machine that wrote them and are
# never committed. The long-lived maintainer state lives in docs/project-memory/.
**/_handoff/

# Local launchers: the double-click .bat wrappers at the repository root are a local
# convenience; the logic they call lives in scripts/*.ps1, which stay tracked.
# flowview/run_flowview.bat is not at the root and is still tracked.
/*.bat

# Root-level throwaway test workspaces created by non-hermetic tests (MF-015); never part of a release.
/tmp*/

# Temporary Jev-config folders leaked by an interrupted evaluation run in the repo cwd.
/matflow-eval-*/
