{
  "version": 1,
  "services": [
    {
      "id": "litellm_gateway",
      "enabled": true,
      "mode": "online_api",
      "working_directory": ".",
      "executable": "uv",
      "arguments": ["run", "litellm", "--config", "config/litellm.yaml", "--host", "127.0.0.1", "--port", "4078"],
      "required_environment": ["SJTU_ZHIYUAN_API_KEY", "LITELLM_DEFAULT_API_KEY"],
      "health_url": "http://127.0.0.1:4078/health/readiness",
      "readiness_url": "http://127.0.0.1:4078/v1/models",
      "readiness_api_key_env": "LITELLM_DEFAULT_API_KEY",
      "startup_timeout_seconds": 60
    },
    {
      "id": "jev_decision_gateway",
      "enabled": true,
      "mode": "local",
      "working_directory": "D:\\Models\\jev\\gateway",
      "executable": "powershell.exe",
      "arguments": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "D:\\Models\\jev\\gateway\\start-jevd.ps1"],
      "required_environment": [],
      "health_url": "http://127.0.0.1:4079/health",
      "startup_timeout_seconds": 30
    }
  ]
}
