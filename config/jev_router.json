{
  "version": 1,
  "router": {
    "enabled": true,
    "strategy": "consensus",
    "profiles": ["laya", "semantic"],
    "timeout_seconds": 45,
    "minimum_calibrated_confidence": 0.7,
    "fallback_to_lexical": true
  },
  "profiles": {
    "laya": {
      "kind": "jev_laya",
      "base_url": "http://127.0.0.1:4079",
      "model": "laya"
    },
    "semantic": {
      "kind": "jev_semantic",
      "base_url": "http://127.0.0.1:4079",
      "model": "semantic",
      "max_tokens": 1024
    }
  }
}
