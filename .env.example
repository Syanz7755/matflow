# Local-only caller credential for the project-managed LiteLLM gateways.
MATFLOW_LITELLM_API_KEY=replace-with-the-local-gateway-key

# Caller key both local gateways accept (config/llm.json and config/llm-deepseek.json).
LITELLM_DEFAULT_API_KEY=

# Upstream credential consumed by config/litellm.yaml. Never commit its value.
SJTU_ZHIYUAN_API_KEY=

# DeepSeek official credential, consumed only by config/litellm-deepseek.yaml
# (the optional multi-model gateway on port 4080). Never commit its value.
DEEPSEEK_API_KEY_MATFLOW_EXCLUSIVE=
