{
  "schema_version": "2.0",
  "suite_id": "workflow-execution-v1",
  "description": "Configured workflow, fixture and parameter execution cases.",
  "defaults": {"service_access": {"jev_like": false, "llm": false}, "repair_budget": 2, "isolation_backend": "docker"},
  "cases": [
    {"case_id": "E01_type_cast", "kind": "workflow_execution", "prompt": "运行 CSV 导入和类型转换。", "inputs": [{"inline_csv": "value\n1.2\n3.4\n"}], "parameters": {"target_type": "TypedTable"}, "workflow": {"required_tools": ["raw_file_import", "type_cast"], "nodes": [{"id": "input", "type": "raw_file_import", "params": {"file_name": "values.csv", "upload_id": "$upload:0"}}, {"id": "cast", "type": "type_cast", "params": {"source_type": "RawData", "target_type": "TypedTable"}}], "edges": [{"id": "input-cast", "source": "input", "source_port": "raw", "target": "cast", "target_port": "value"}]}, "expected": {"status": "completed", "row_count_preserved": true}},
    {"case_id": "E02_eis_qc", "kind": "workflow_execution", "prompt": "运行 EIS 基础质检和 Nyquist 图。", "inputs": [{"fixture": "examples/data/01_eis_basic_qc/eis_spectrum.csv"}], "parameters": {"min_frequency_hz": 10}, "workflow": {"required_tools": ["raw_file_import", "normalize_columns", "eis_basic_qc", "plot_nyquist"], "nodes": [{"id": "input", "type": "raw_file_import", "params": {"file_name": "eis.csv", "upload_id": "$upload:0"}}, {"id": "map", "type": "normalize_columns", "params": {"frequency_column": "frequency_hz", "real_column": "z_real_ohm", "imag_column": "z_imag_ohm"}}, {"id": "qc", "type": "eis_basic_qc", "params": {"min_frequency_hz": 10, "fit_model": "None"}}, {"id": "plot", "type": "plot_nyquist", "params": {"title": "Nyquist plot"}}], "edges": [{"id": "input-map", "source": "input", "source_port": "raw", "target": "map", "target_port": "raw"}, {"id": "map-qc", "source": "map", "source_port": "table", "target": "qc", "target_port": "data"}, {"id": "qc-plot", "source": "qc", "source_port": "data", "target": "plot", "target_port": "data"}]}, "expected": {"status": "completed", "output_kinds": ["EISQCReport", "Plot"]}},
    {"case_id": "E03_eis_missing_column", "kind": "workflow_execution", "prompt": "对缺少虚部列的 EIS 表运行质检。", "inputs": [{"inline_csv": "frequency_hz,z_real\n100,5\n"}], "workflow": {"required_tools": ["raw_file_import", "normalize_columns", "eis_basic_qc"], "nodes": [{"id": "input", "type": "raw_file_import", "params": {"file_name": "bad.csv", "upload_id": "$upload:0"}}, {"id": "map", "type": "normalize_columns", "params": {"frequency_column": "frequency_hz", "real_column": "z_real", "imag_column": "z_imag"}}, {"id": "qc", "type": "eis_basic_qc", "params": {"min_frequency_hz": 10, "fit_model": "None"}}], "edges": [{"id": "input-map", "source": "input", "source_port": "raw", "target": "map", "target_port": "raw"}, {"id": "map-qc", "source": "map", "source_port": "table", "target": "qc", "target_port": "data"}]}, "expected": {"status": "failed", "error_contains": "Column mapping"}},
    {"case_id": "E04_uvvis_unavailable", "kind": "workflow_execution", "prompt": "运行 UV-Vis 浓度衰减。", "inputs": [{"fixture": "examples/data/03_uvvis_methylene_blue_decay/calibration_curve.csv"}, {"fixture": "examples/data/03_uvvis_methylene_blue_decay/absorbance_time_series.csv"}], "workflow": {"required_tools": ["uvvis_decay_analysis"]}, "expected": {"status": "waiting_for_tool", "no_scientific_result": true}},
    {"case_id": "E05_tga_unavailable", "kind": "workflow_execution", "prompt": "用两个温区运行 TGA CaCO3 含量估算。", "inputs": [{"fixture": "examples/data/05_tga_caco3_content/tga_mass_loss.csv"}], "parameters": {"temperature_ranges_c": [[650, 850], [30, 200]]}, "workflow": {"required_tools": ["tga_caco3_estimation"]}, "expected": {"status": "waiting_for_tool", "no_scientific_result": true}},
    {"case_id": "E06_four_point_unavailable", "kind": "workflow_execution", "prompt": "分别按 100 nm 和 200 nm 计算四探针电阻率。", "inputs": [{"fixture": "examples/data/08_four_point_probe_resistivity/four_point_measurements.csv"}], "parameters": {"thickness_nm": [100, 200]}, "workflow": {"required_tools": ["four_point_probe_resistivity"]}, "expected": {"status": "waiting_for_tool", "relationship": "rho_200nm_is_twice_rho_100nm", "no_scientific_result": true}},
    {"case_id": "E07_tensile_unavailable", "kind": "workflow_execution", "prompt": "按给定弹性区间和偏移量运行拉伸分析。", "inputs": [{"fixture": "examples/data/09_tensile_curve_analysis/tensile_curve.csv"}], "parameters": {"elastic_strain_percent": [0, 0.15], "yield_offset_percent": 0.2}, "workflow": {"required_tools": ["tensile_curve_analysis"]}, "expected": {"status": "waiting_for_tool", "no_scientific_result": true}},
    {"case_id": "E08_human_review", "kind": "workflow_execution", "prompt": "导入后暂停，等待人工确认再继续。", "inputs": [{"fixture": "examples/data/01_eis_basic_qc/eis_spectrum.csv"}], "parameters": {"review_after_run": true, "decision": "continue"}, "workflow": {"required_tools": ["raw_file_import"], "nodes": [{"id": "input", "type": "raw_file_import", "params": {"file_name": "eis.csv", "upload_id": "$upload:0"}, "review_policy": {"after_run": true, "prompt": "Review imported data."}}], "edges": [], "review": {"node_id": "input", "decision": "continue"}}, "expected": {"status_sequence": ["waiting", "completed"]}},
    {"case_id": "E09_parallel_partial_failure", "kind": "workflow_execution", "prompt": "并行运行 FTIR 和缺列的四探针数据。", "inputs": [{"fixture": "examples/data/configured_analysis/ftir/ftir_20260930.csv"}, {"inline_csv": "current_ma\n1\n"}], "workflow": {"required_tools": ["reference_ftir_functional_group_assignment", "four_point_probe_resistivity"], "mode": "parallel"}, "expected": {"status": "partial_failure", "successful_branch": "ftir", "failed_branch": "four_point"}},
    {"case_id": "E10_batch_eis_partial_failure", "kind": "workflow_execution", "prompt": "批量运行三份 EIS，其中一份有非数值数据。", "inputs": [{"fixture": "examples/data/01_eis_basic_qc/eis_spectrum.csv"}, {"fixture": "examples/data/01_eis_basic_qc/eis_spectrum.csv"}, {"inline_csv": "frequency_hz,z_real_ohm,z_imag_ohm\nbad,5,-1\n"}], "parameters": {"failure_policy": "continue"}, "workflow": {"required_tools": ["raw_file_import", "normalize_columns", "eis_basic_qc"], "mode": "batch"}, "expected": {"completed_items": 2, "failed_items": 1}},
    {"case_id": "E11_repeatability", "kind": "workflow_execution", "prompt": "用相同输入和参数连续运行两次 EIS 工作流。", "inputs": [{"fixture": "examples/data/01_eis_basic_qc/eis_spectrum.csv"}], "parameters": {"runs": 2}, "workflow": {"required_tools": ["raw_file_import", "normalize_columns", "eis_basic_qc"], "mode": "repeat"}, "expected": {"status": "completed", "results_equal": true, "traceable": true}},
    {"case_id": "E12_incremental_rerun", "kind": "workflow_execution", "prompt": "修改中间节点参数后重新运行受影响下游。", "inputs": [{"fixture": "examples/data/01_eis_basic_qc/eis_spectrum.csv"}], "parameters": {"initial_min_frequency_hz": 10, "updated_min_frequency_hz": 100}, "workflow": {"required_tools": ["raw_file_import", "normalize_columns", "eis_basic_qc"], "mode": "incremental_rerun"}, "expected": {"status": "completed", "unrelated_upstream_reused": true, "downstream_recomputed": true}},
    {"case_id": "E13_invalid_parameter", "kind": "workflow_execution", "prompt": "使用非法负膜厚运行分析。", "inputs": [{"fixture": "examples/data/08_four_point_probe_resistivity/four_point_measurements.csv"}], "parameters": {"thickness_nm": -1}, "workflow": {"required_tools": ["four_point_probe_resistivity"]}, "expected": {"status": "failed_validation", "no_execution": true}},
    {"case_id": "E14_missing_rietveld", "kind": "workflow_execution", "prompt": "运行未安装的 Rietveld 工具。", "inputs": [{"fixture": "examples/data/configured_analysis/xrd/xrd_20260930.csv"}], "workflow": {"required_tools": ["rietveld_refinement"]}, "expected": {"status": "waiting_for_tool", "requested_tool": "rietveld_refinement", "no_scientific_result": true}}
  ]
}
